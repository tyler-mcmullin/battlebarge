{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "api:generate": "npx --yes openapi-typescript@7 ../docs/openapi.yaml -o src/app/api/schema.d.ts",
    "api:check": "npx --yes openapi-typescript@7 ../docs/openapi.yaml -o /tmp/battlebarge-schema.check.d.ts && diff -q src/app/api/schema.d.ts /tmp/battlebarge-schema.check.d.ts",
    "format": "prettier --write \"src/**/*.{ts,html,scss}\"",
    "test:ci": "ng test --watch=false"
  },
  "private": true,
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@angular/cdk": "^22.2.2",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/material": "^22.2.2",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "firebase": "^13.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.3",
    "@angular/cli": "^22.1.3",
    "@angular/compiler-cli": "^22.1.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6"
  }
}
